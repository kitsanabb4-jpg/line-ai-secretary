########################################################################
# LINE AI Personal Secretary — Environment Variables
# คัดลอกไฟล์นี้เป็น ".env" แล้วกรอกค่าตามคำแนะนำใน SETUP.md
# ห้าม commit ไฟล์ .env จริงขึ้น git เด็ดขาด
########################################################################

# ------------------------------------------------------------------
# โหมดการทำงาน
# ------------------------------------------------------------------
# DEMO_MODE=true  -> ไม่ต้องใช้ LINE / AI จริง ใช้ mock ทั้งหมด ทดสอบผ่าน CLI ได้ (npm run demo)
# DEMO_MODE=false -> โหมด production ใช้บริการจริงทั้งหมด (ต้องกรอกค่าด้านล่างให้ครบ)
DEMO_MODE=true

# พอร์ตที่ server จะรัน (ปรับได้ตามต้องการ ผู้ให้บริการ deploy ส่วนใหญ่จะกำหนดให้อัตโนมัติ)
PORT=3000

# ใช้ระบุ timezone ของผู้ใช้ทั้งหมด (ค่าเริ่มต้นและแนะนำ: Asia/Bangkok)
APP_TIMEZONE=Asia/Bangkok

# ------------------------------------------------------------------
# ฐานข้อมูล
# ค่าเริ่มต้น = SQLite ไฟล์เดียว ใช้งานได้ทันทีไม่ต้องสมัครอะไร (เหมาะกับ DEMO_MODE / local dev)
# สำหรับ production แนะนำ Supabase (ฟรี 500MB Postgres) หรือ Neon (ฟรี) — ดู SETUP.md
# ถ้าจะใช้ Postgres: เปลี่ยน provider ใน prisma/schema.prisma เป็น "postgresql" ก่อน แล้วใส่
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"
# ------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------------------------
# LINE Official Account (สมัครฟรีที่ https://developers.line.biz)
# ------------------------------------------------------------------
# Messaging API Channel access token (long-lived) จาก LINE Developers Console
LINE_CHANNEL_ACCESS_TOKEN=REPLACE_WITH_LINE_CHANNEL_ACCESS_TOKEN
# Channel secret ใช้ตรวจสอบลายเซ็น webhook
LINE_CHANNEL_SECRET=REPLACE_WITH_LINE_CHANNEL_SECRET

# ------------------------------------------------------------------
# AI Provider (Provider Abstraction Layer — เลือกได้ 1 ค่า)
# รองรับ: "gemini" | "groq" | "openai" | "openrouter" | "mock"
# แนะนำเริ่มต้นฟรี: gemini (Google AI Studio free tier รองรับภาษาไทยดี)
#              หรือ groq (free tier เร็วมาก ใช้ Llama 3.1)
# ------------------------------------------------------------------
AI_PROVIDER=mock

# Google Gemini (ฟรีที่ https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# Groq (ฟรีที่ https://console.groq.com/keys)
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=llama-3.1-70b-versatile

# OpenAI (มีค่าใช้จ่าย ใช้เป็นทางเลือกเสริมเท่านั้น)
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (มี free models บางตัว https://openrouter.ai/keys)
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ------------------------------------------------------------------
# Speech-to-Text Provider (Abstraction Layer)
# รองรับ: "groq_whisper" | "openai_whisper" | "mock"
# แนะนำเริ่มต้นฟรี: groq_whisper (Whisper large-v3 ฟรี รองรับภาษาไทย เร็วมาก)
# ------------------------------------------------------------------
STT_PROVIDER=mock
# ใช้ GROQ_API_KEY ตัวเดียวกับด้านบนได้เลยถ้าเลือก groq_whisper
STT_GROQ_MODEL=whisper-large-v3
# ถ้าเลือก openai_whisper จะใช้ OPENAI_API_KEY ด้านบน
STT_OPENAI_MODEL=whisper-1

# ------------------------------------------------------------------
# Scheduler / Reminder Engine
# ------------------------------------------------------------------
# secret สำหรับป้องกันไม่ให้คนอื่นยิง endpoint /api/scheduler/tick มั่ว ๆ
# ตั้งเป็นค่าสุ่มยาว ๆ แล้วนำไปตั้งใน cron-job.org (ดู SETUP.md)
SCHEDULER_SECRET=REPLACE_WITH_RANDOM_LONG_STRING

# ------------------------------------------------------------------
# Preferences เริ่มต้น (ผู้ใช้ปรับต่อคนได้ภายหลังผ่านแชท/ตั้งค่า)
# ------------------------------------------------------------------
DEFAULT_DAILY_BRIEFING_TIME=07:00
DEFAULT_EVENING_SUMMARY_TIME=20:00
DEFAULT_DAILY_BRIEFING_ENABLED=false
DEFAULT_EVENING_SUMMARY_ENABLED=false

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=info
