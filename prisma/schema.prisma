// Prisma schema — LINE AI Personal Secretary
// เวอร์ชัน PostgreSQL สำหรับ production (Supabase/Neon free tier)
// วิธีใช้: cp prisma/schema.postgres.prisma prisma/schema.prisma แล้วรัน npx prisma migrate dev --name init
// ดูขั้นตอนแบบละเอียดใน SETUP.md หัวข้อ "ฐานข้อมูล (Production)"
// (PostgreSQL รองรับ enum จริง จึงใช้ enum แทน String เพื่อความปลอดภัยของข้อมูลที่ดีกว่า SQLite)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReminderType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ReminderStatus {
  PENDING
  COMPLETED
  SNOOZED
  MISSED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MemoryType {
  PERSONAL
  PREFERENCE
  WORK
  FINANCE
  TASK
  IMPORTANT_FACT
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  OVERDUE
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  ACKNOWLEDGED
}

model User {
  id             String   @id @default(cuid())
  lineUserId     String   @unique
  displayName    String?
  timezone       String   @default("Asia/Bangkok")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preferences    Preference?
  messages       Message[]
  conversations  Conversation[]
  memories       Memory[]
  tasks          Task[]
  reminders      Reminder[]
  events         Event[]
  payments       Payment[]
  debts          Debt[]
  medications    Medication[]
  notifications  Notification[]

  @@index([lineUserId])
}

model Preference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyBriefingEnabled     Boolean  @default(false)
  dailyBriefingTime        String   @default("07:00")
  eveningSummaryEnabled    Boolean  @default(false)
  eveningSummaryTime       String   @default("20:00")
  updatedAt                DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction   String
  channel     String
  content     String
  intent      String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Conversation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingIntent  String?
  pendingParams  String?
  lastEntityRef  String?
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Memory {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       MemoryType
  content    String
  tags       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@index([type])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  dueDate     DateTime?
  status      TaskStatus @default(PENDING)
  sourceText  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reminders   Reminder[]

  @@index([userId])
  @@index([dueDate])
  @@index([status])
}

model Reminder {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId            String?
  task              Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title             String
  reminderTime      DateTime
  type              ReminderType   @default(ONE_TIME)
  recurrenceRule    String?
  offsetMinutes     Int            @default(0)
  status            ReminderStatus @default(PENDING)
  snoozeCount       Int            @default(0)
  originalTime      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  notifications     Notification[]

  @@index([userId])
  @@index([reminderTime])
  @@index([status])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  startTime   DateTime
  endTime     DateTime?
  location    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([startTime])
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  amount      Float?
  dueDate     DateTime
  isRecurring Boolean   @default(false)
  recurrenceRule String?
  paidAt      DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([dueDate])
}

model Debt {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditor             String
  originalAmount       Float
  remainingAmount      Float
  minimumPayment       Float?
  interestRate         Float?
  dueDate              DateTime?
  installmentsRemaining Int?
  status               DebtStatus @default(ACTIVE)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([userId])
  @@index([dueDate])
  @@index([status])
}

model Medication {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  dosage        String?
  scheduleTimes String
  startDate     DateTime @default(now())
  endDate       DateTime?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderId  String?
  reminder    Reminder?          @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  message     String
  scheduledAt DateTime
  sentAt      DateTime?
  status      NotificationStatus @default(QUEUED)
  createdAt   DateTime           @default(now())

  @@index([userId])
  @@index([scheduledAt])
  @@index([status])
}
